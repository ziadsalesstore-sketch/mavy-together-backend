# Copy to .env. Never commit .env.

# From this app's own record in the Shopify Partner / Dev Dashboard
# (created by `npm run config:link`). A separate app from Ordinary Club and Mavy Edit.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# This app needs no Admin API scopes (App Proxy + embedded admin only). Leave empty.
SCOPES=

# Public URL of the deployed app (or the tunnel URL during local dev).
SHOPIFY_APP_URL=

# A separate free Postgres (e.g. a new Supabase project). On networks without IPv6
# use Supabase's Session pooler string (host ...pooler.supabase.com), not the direct host.
DATABASE_URL=
